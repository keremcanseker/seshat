# Postgres connection (Supabase üzerinden Coolify'da DATABASE_URL alacaksın)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres

# HTTP server
PORT=3000

# Public base URL — share linklerinde kullanılır (https://seshat.<domain>)
PUBLIC_BASE_URL=http://localhost:3000

# CORS — virgülle ayrılmış origin listesi. Boş bırakırsan tüm originler kapalı.
CORS_ORIGINS=http://localhost:3000

# Yazma uçları için bearer token. macOS app keychain'inde saklayacak.
# Boş bırakırsan yazma uçları açık olur (sadece local dev için).
WRITE_TOKEN=
