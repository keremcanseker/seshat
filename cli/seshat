#!/bin/sh
# Seshat CLI — opens markdown files in the Seshat reader.
# Bundled inside Seshat.app/Contents/Resources/seshat and symlinked into PATH.

set -e

usage() {
    cat >&2 <<EOF
seshat — native macOS markdown reader

usage:
  seshat open <file.md>       Open a file in a reader window
  seshat global [<file.md>]   Open the workspace (reveals file in sidebar if given)
  seshat export <file.md> [out.pdf] [--landscape]
                              Save a PDF (default: next to the file, same name)
  seshat install [target]     Symlink the CLI into PATH (default: /usr/local/bin/seshat)
  seshat help                 Show this message
EOF
}

abs_path() {
    case "$1" in
        /*) printf %s "$1" ;;
        *)  printf %s "$(pwd)/$1" ;;
    esac
}

# Minimal URL encoding for the most common path-breaking characters.
# Encodes % first so we don't double-escape.
url_encode() {
    printf %s "$1" | sed \
        -e 's|%|%25|g' \
        -e 's| |%20|g' \
        -e 's|#|%23|g' \
        -e 's|?|%3F|g' \
        -e 's|&|%26|g'
}

# Send a seshat:// URL to the app this script is bundled in, so a second copy of
# Seshat (an older release beside a dev build, say) never steals the request.
open_url() {
    script="$0"
    while [ -L "$script" ]; do
        link="$(readlink "$script")"
        case "$link" in
            /*) script="$link" ;;
            *)  script="$(dirname "$script")/$link" ;;
        esac
    done
    app="$(cd "$(dirname "$script")/../.." 2>/dev/null && pwd)"
    case "$app" in
        *.app) open -a "$app" "$1" ;;
        *)     open "$1" ;;
    esac
}

cmd="${1:-}"
[ -z "$cmd" ] && { usage; exit 1; }
shift || true

case "$cmd" in
    open)
        if [ -z "${1:-}" ]; then
            echo "seshat open: missing <file.md>" >&2
            exit 1
        fi
        if [ ! -f "$1" ]; then
            echo "seshat: file not found: $1" >&2
            exit 1
        fi
        abs="$(abs_path "$1")"
        encoded="$(url_encode "$abs")"
        open_url "seshat://open?path=$encoded"
        ;;

    global)
        if [ -n "${1:-}" ]; then
            if [ ! -f "$1" ]; then
                echo "seshat: file not found: $1" >&2
                exit 1
            fi
            abs="$(abs_path "$1")"
            encoded="$(url_encode "$abs")"
            open_url "seshat://global?path=$encoded"
        else
            open_url "seshat://global"
        fi
        ;;

    export)
        src=""; out=""; landscape=0
        for arg in "$@"; do
            case "$arg" in
                --landscape) landscape=1 ;;
                --portrait) landscape=0 ;;
                -*) echo "seshat export: unknown option '$arg'" >&2; exit 1 ;;
                *) if [ -z "$src" ]; then src="$arg"; elif [ -z "$out" ]; then out="$arg"; else
                       echo "seshat export: too many arguments" >&2; exit 1; fi ;;
            esac
        done
        if [ -z "$src" ]; then
            echo "seshat export: missing <file.md>" >&2
            exit 1
        fi
        if [ ! -f "$src" ]; then
            echo "seshat: file not found: $src" >&2
            exit 1
        fi
        src="$(abs_path "$src")"
        [ -z "$out" ] && out="${src%.*}.pdf"
        out="$(abs_path "$out")"
        rm -f "$out.error"
        started="$(date +%s)"
        open_url "seshat://export?path=$(url_encode "$src")&out=$(url_encode "$out")&landscape=$landscape"
        # The app renders in the background; wait for the file (or an error note) to land.
        tries=0
        while [ "$tries" -lt 150 ]; do
            if [ -f "$out.error" ]; then
                echo "seshat: $(cat "$out.error")" >&2
                rm -f "$out.error"
                exit 1
            fi
            if [ -f "$out" ] && [ "$(stat -f %m "$out")" -ge "$started" ]; then
                echo "$out"
                exit 0
            fi
            sleep 0.2
            tries=$((tries + 1))
        done
        echo "seshat: export timed out; is Seshat installed and allowed to open seshat:// links?" >&2
        exit 1
        ;;

    install)
        target="${1:-/usr/local/bin/seshat}"
        app="$(mdfind "kMDItemCFBundleIdentifier == 'com.keremcan.seshat'" 2>/dev/null | head -n 1)"
        if [ -z "$app" ]; then
            echo "seshat: Seshat.app not found via Spotlight." >&2
            echo "Open Seshat at least once (move it to /Applications if possible), then retry." >&2
            exit 1
        fi
        bin="$app/Contents/Resources/seshat"
        if [ ! -f "$bin" ]; then
            echo "seshat: CLI binary missing in $bin" >&2
            exit 1
        fi
        target_dir="$(dirname "$target")"
        mkdir -p "$target_dir" 2>/dev/null || true
        if ln -sf "$bin" "$target" 2>/dev/null; then
            echo "Installed: $target -> $bin"
        else
            echo "seshat: cannot write to $target_dir without permission." >&2
            echo "Try: sudo ln -sf '$bin' '$target'" >&2
            exit 1
        fi
        ;;

    help|-h|--help)
        usage
        ;;

    *)
        echo "seshat: unknown command '$cmd'" >&2
        usage
        exit 1
        ;;
esac
